# Copy to .env. Never commit .env.
SB_ENV=dev
SB_LOG_LEVEL=INFO

# Telegram (BotFather)
SB_BOT_TOKEN=123456:ABC...
SB_BOT_MODE=polling
SB_ADMIN_IDS=[123456789]
SB_ADMIN_CHAT_ID=123456789

# Infra (docker-compose defaults)
SB_DATABASE_URL=postgresql+asyncpg://storybook:storybook@postgres:5432/storybook
SB_REDIS_URL=redis://redis:6379/0
SB_S3_ENDPOINT=http://minio:9000
SB_S3_BUCKET=storybook
SB_S3_ACCESS_KEY=minio
SB_S3_SECRET_KEY=minio12345

# Product
SB_PRICE_KZT=6990
SB_PREVIEW_DAILY_LIMIT=2
SB_HUMAN_REVIEW=true

# Payments: mock | kaspi_link | stars
SB_PAYMENT_PROVIDER=mock
SB_KASPI_PAYMENT_LINK=https://pay.kaspi.kz/pay/xxxxxxxx
SB_STARS_PRICE=500

# Generation: mock works without keys. Switch to anthropic / gemini when keys are available.
SB_STORY_PROVIDER=mock
SB_IMAGE_PROVIDER=mock
SB_FACE_QA=noop
SB_ANTHROPIC_API_KEY=
SB_GEMINI_API_KEY=
SB_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
SB_GEMINI_IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image
SB_DAILY_AI_BUDGET_KZT=30000
SB_USD_KZT=530

# Analytics (optional mirror)
SB_POSTHOG_API_KEY=
